# =============================================================================
# Discord AI Chatbot - example environment file
# Copy to `.env` (same directory) and fill in real values.
# NEVER commit your real `.env`.
# =============================================================================

# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your-discord-bot-token

# Verified numeric Discord user ID of the sole bot owner (NOT a username).
# Enable Developer Mode in Discord, right-click your user, "Copy User ID".
BOT_OWNER_ID=123456789012345678

# Respond when a user replies to one of the bot's own messages.
ENABLE_REPLY_CONVERSATIONS=true

# Only respond when the message literally starts with the bot mention.
# Set to false to also respond to a mention that appears later in the message.
STRICT_MENTION=true

# Optional comma-separated guild IDs to instantly sync slash commands into
# (useful for local development; global sync can take up to an hour).
DISCORD_GUILD_IDS=

# --- AI provider -------------------------------------------------------------
# Any OpenAI-compatible provider: openai, openrouter, groq, together, deepseek,
# ollama, lmstudio, azure-openai, or "openai_compatible" for a self-hosted API.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your-ai-api-key
# Optional. Set for self-hosted / proxy / non-default OpenAI-compatible endpoints.
# Examples:
#   OpenRouter      -> https://openrouter.ai/api/v1
#   Ollama          -> http://localhost:11434/v1
#   LM Studio       -> http://localhost:1234/v1
AI_BASE_URL=
# Advanced AI tuning (optional)
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT=60
AI_MAX_RETRIES=3
# Only used by the azure-openai provider.
AI_API_VERSION=2024-06-01

# --- Database ----------------------------------------------------------------
# SQLite is the default. A file path or `sqlite:///path` URL both work.
DATABASE_URL=sqlite:///data/bot.db

# --- Conversation & context limits -------------------------------------------
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_TOKENS=8000
SUMMARIZE_AFTER_MESSAGES=40
CONTEXT_RETENTION_DAYS=0

# --- File handling limits ----------------------------------------------------
MAX_ATTACHMENT_BYTES=5000000
MAX_ARCHIVE_BYTES=20000000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=100000000
MAX_ARCHIVE_FILES=2000
MAX_ARCHIVE_DEPTH=10
MAX_ARCHIVE_COMPRESSION_RATIO=200
MAX_GENERATED_FILES=40
MAX_GENERATED_FILE_BYTES=2000000

# --- Sandbox execution -------------------------------------------------------
# Disabled by default: only static analysis / syntax validation is performed.
# Never enable host execution from untrusted input.
ENABLE_SANDBOX_EXECUTION=false
SANDBOX_BACKEND=none
SANDBOX_TIMEOUT=10
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=1.0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Set to true to log message text (PRIVATE content). Off by default for privacy.
LOG_PRIVATE_CONTENT=false

# --- HTTP health endpoint -----------------------------------------------------
# Set automatically from $PORT on Render. Binding it lets an uptime monitor
# (UptimeRobot/Better Stack) keep a free Render web service awake, since a
# Discord gateway connection is outbound and does not count as inbound traffic.
HEALTH_PORT=

# =============================================================================
# Infrastructure control plane  (owner-only /vm commands)
# DISABLED AND IN DRY-RUN BY DEFAULT. Nothing real is created until you both
# enable it AND set a provider token AND set INFRA_DRY_RUN=false.
# =============================================================================
INFRA_ENABLED=false
INFRA_DRY_RUN=true

# Quotas are the only reliable cost control (provider billing alerts arrive
# *after* spend). Refuse requests locally instead.
INFRA_MAX_TARGETS=5
INFRA_MAX_CONCURRENT_DEPLOYS=2
INFRA_NAME_PATTERN=^[a-z0-9][a-z0-9-]{1,40}$

# --- Render (free-friendly; managed services, not raw VMs) --------------------
# Render API key. NOTE: key access is workspace-wide, so treat it as a
# high-impact secret and never let it reach generated code, logs, or prompts.
RENDER_API_KEY=
# Optional: the workspace/owner ID new services are created under.
RENDER_OWNER_ID=

# --- Fly.io (real microVMs) ---------------------------------------------------
# Fly has NO free monthly allowance (short trial only), so this stays disabled
# unless you have a paid account.
FLY_API_TOKEN=
FLY_APP_NAME=

# --- Deploy paths -------------------------------------------------------------
# Git path: the bot commits and pushes to this remote, then triggers a deploy.
INFRA_GIT_REMOTE=
INFRA_GIT_BRANCH=main
# Docker path: the bot builds an image from the generated files and pushes it.
DOCKER_REGISTRY=
DOCKER_IMAGE_PREFIX=discord-bot

# =============================================================================
# Autonomous developer agent
# DRY-RUN BY DEFAULT: mutating tools (commits, PRs, deploys, VM runs) are
# simulated until you set AGENT_DRY_RUN=false.
# =============================================================================
AGENT_DRY_RUN=true
# Hard bounds - always enforced, independent of the model.
AGENT_TASK_DEADLINE=900
AGENT_MAX_TOOL_CALLS=40
AGENT_MAX_STEP_ATTEMPTS=3
AGENT_MAX_CONCURRENT_TASKS=2
AGENT_APPROVAL_TTL=3600

# --- GitHub (App preferred; PAT as fallback) ----------------------------------
# Only ONE method needs to be configured. Switch by changing GITHUB_AUTH.
GITHUB_AUTH=app
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/discord-bot/github-app.pem
# Fallback, used only when GITHUB_AUTH=pat. Use a fine-grained token scoped to
# the minimum repositories and permissions.
GITHUB_TOKEN_PAT=
GITHUB_API_BASE=https://api.github.com
# Comma-separated allowlist of repositories the agent may touch.
GITHUB_ALLOWED_REPOS=

# --- VM execution worker ------------------------------------------------------
# Narrow authenticated API on the worker VM. Never expose it publicly without
# network restrictions in addition to WORKER_TOKEN.
WORKER_URL=
WORKER_TOKEN=
WORKER_TIMEOUT=120

# --- Surge static hosting -----------------------------------------------------
SURGE_TOKEN=
# Comma-separated allowlist; "*.example.com" matches subdomains.
SURGE_ALLOWED_DOMAINS=
